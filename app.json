{
  "expo": {
    "name": "GYMcontrol",
    "slug": "gymcontrol",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gymcontrol",
    "userInterfaceStyle": "dark",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {},
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/GYMcontrol"
    }
  }
}
